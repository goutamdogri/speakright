# SpeakRight — developer seed for cloud API keys.
#
# Copy this file to `.env` (gitignored) and fill in the providers you use.
# Keys set here are read by the main process and are used automatically.
# When a key is also saved through the Settings UI, the UI-saved (OS-keychain)
# value takes precedence over the one here.
#
# SAFETY: never commit the real `.env`. Only this `.env.example` may be committed.

# Groq  (STT whisper + LLM)   — https://console.groq.com/keys
SPEAKRIGHT_GROQ_API_KEY=

# OpenAI (STT whisper + LLM)  — https://platform.openai.com/api-keys
SPEAKRIGHT_OPENAI_API_KEY=

# Google Gemini (STT + LLM)   — https://aistudio.google.com/apikey
SPEAKRIGHT_GEMINI_API_KEY=