{
  "name": "speakright",
  "version": "0.1.0",
  "private": true,
  "description": "Personal English Speaking Coach — real-time spoken-English correction overlay",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @speakright/desktop dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash scripts/run-integration.sh db",
    "test:e2e": "bash scripts/run-integration.sh e2e",
    "rebuild": "electron-rebuild -f -w better-sqlite3 --types=prod,dev,optional && electron-rebuild -f -w=sherpa-onnx-node",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\"",
    "clean": "pnpm -r exec rm -rf node_modules dist build tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "@electron/rebuild": "^3.6.0"
  }
}
